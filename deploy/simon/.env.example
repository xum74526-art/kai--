# Copy this file to deploy/simon/.env on the server. Do not commit the real file.
COMPOSE_PROJECT_NAME=beidou-kai
# 每次上线使用新的不可复用标签，保留旧镜像才可可靠回滚。
KAI_IMAGE_TAG=20260825-01
KAI_HTTP_PORT=5173

# Absolute server path containing the deployment copy of open_ai_canvas.db,
# .settings-key, and any local resource files used by this database.
KAI_DATA_PATH=/srv/beidou-kai/data

CANVAS_WORKER_CONCURRENCY=2
CANVAS_CHANNEL_CONCURRENCY=2
# 已有唯一管理员时可按业务需要开放普通用户注册；新注册账号不会获得管理员角色。
CANVAS_REGISTRATION_ENABLED=true
GOPROXY=https://proxy.golang.org,direct

# Optional. Leave empty unless this deployment has a valid tldraw license.
VITE_TLDRAW_LICENSE_KEY=
