# 本文件只声明可公开的运行配置，不要在这里填写任何密钥。
CANVAS_REGISTRATION_ENABLED=false
# 已废弃的全局私网放行必须保持 false；设为 true 会拒绝启动。
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
# 可信模型上游按主机精确放行，不要填写协议、端口或路径；远程素材导入永不继承此白名单。
# 多个主机使用英文逗号分隔，例如：gateway.internal,192.168.1.10
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
# 仅 Windows + 虚拟网卡路径出现大请求上传重置时启用；允许后端 IPv4 外连按需分片，修改后需重启后端。
CANVAS_OUTBOUND_DISABLE_IPV4_PMTUD=false
# “允许本机渠道”是独立的桌面部署能力，默认关闭；只有后端实际绑定 127.0.0.1 时 true 才会生效。
CANVAS_DESKTOP_LOCAL_CHANNELS_ENABLED=false
# 桌面本机渠道启用时必须显式使用：CANVAS_BACKEND_ADDR=127.0.0.1:8080
# 凭证请求不接受 *，多个完整 Origin 使用英文逗号分隔。
CANVAS_CORS_ORIGINS=http://localhost:3000
# 默认不信任 X-Forwarded-*；反向代理部署时仅填写代理容器/主机的 IP 或窄 CIDR，多个值用英文逗号分隔。
CANVAS_TRUSTED_PROXIES=
# 仅源码构建或专用子路径 Compose 使用；预构建的通用 deploy 镜像固定为根路径。
# 反向代理把应用挂载到子路径时设置，例如 /kai；默认 / 保持根路径行为。
CANVAS_PUBLIC_BASE_PATH=/
# 对外访问的完整应用地址，用于 OAuth 回调和绝对跳转；根路径部署可留空。
CANVAS_PUBLIC_BASE_URL=
# 前端部署在域名子路径时设置，例如 /kai/；默认 / 保持现有根路径行为。
VITE_APP_BASE_PATH=/
# 留空时 API 自动跟随前端子路径（/api 或 /kai/api）；跨域后端才需要显式填写完整地址。
VITE_CANVAS_BACKEND_URL=
# 启用服务商插件系统以支持特定服务的模型发现（如阿里云百炼的视频生成模型）
# 设置为 true 启用插件机制，false 使用传统方式（默认：false）
ENABLE_PROVIDER_PLUGINS=false
CANVAS_DATA_PATH=./data
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3

# 新服务器请直接运行 README 的一键部署命令；脚本会在 .env 中生成以下 PostgreSQL 配置。
# POSTGRES_DB=open_ai_canvas
# POSTGRES_USER=open_ai_canvas
# POSTGRES_PASSWORD=由部署脚本随机生成
# DATABASE_URL=postgresql://open_ai_canvas:随机密码@postgres:5432/open_ai_canvas?sslmode=disable
# REDIS_URL=redis://redis:6379/0
# CANVAS_POSTGRES_DATA_PATH=./postgres-data
# CANVAS_REDIS_DATA_PATH=./redis-data
# CANVAS_HTTP_PORT=3000
